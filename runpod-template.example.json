{
  "name": "MiniMax-H3-I2V-R2V-Ephemeral-Xet",
  "imageName": "ghcr.io/grawthings-beep/minimax-h3-i2v:0.3.2",
  "containerDiskInGb": 120,
  "volumeInGb": 0,
  "volumeMountPath": "/workspace",
  "ports": [
    "8188/http"
  ],
  "env": {
    "ACCEPT_MINIMAX_H3_LICENSE": "0",
    "MINIMAX_H3_LICENSEE_IN_APPLICABLE_TERRITORY": "0",
    "MINIMAX_H3_SEPARATE_LICENSE": "0",
    "TINI_SUBREAPER": "1",
    "HF_XET_HIGH_PERFORMANCE": "auto",
    "HF_XET_CHUNK_CACHE_SIZE_BYTES": "0",
    "HF_DOWNLOAD_WORKERS": "4",
    "HF_HUB_DOWNLOAD_TIMEOUT": "120",
    "DOWNLOAD_RETRIES": "3",
    "MODEL_VERIFY": "sha256",
    "REQUIRE_COMFY_KITCHEN_CUDA": "1",
    "COMFYUI_ARGS": "--vram-headroom 2"
  }
}
