{
  "name": "MiniMax-H3-Character-R2VA-Only-CU130",
  "imageName": "ghcr.io/grawthings-beep/minimax-h3-i2v:fast-cu130",
  "containerDiskInGb": 120,
  "volumeInGb": 0,
  "volumeMountPath": "/workspace",
  "ports": ["8188/http"],
  "env": {
    "HF_TOKEN": "",
    "CIVITAI_API_TOKEN": "",
    "ACCEPT_MINIMAX_H3_LICENSE": "0",
    "MINIMAX_H3_LICENSEE_IN_APPLICABLE_TERRITORY": "0",
    "MINIMAX_H3_SEPARATE_LICENSE": "0",
    "H3_PROFILE": "r2v",
    "H3_FAST_VAE": "1",
    "AUTO_MOSAIC_REQUIRED": "1",
    "AUTO_MOSAIC_MANIFEST": "/opt/minimax-h3/manifests/auto_mosaic.json",
    "HF_XET_HIGH_PERFORMANCE": "auto",
    "HF_XET_CHUNK_CACHE_SIZE_BYTES": "0",
    "HF_DOWNLOAD_WORKERS": "4",
    "HF_HUB_DOWNLOAD_TIMEOUT": "120",
    "DOWNLOAD_RETRIES": "3",
    "MODEL_VERIFY": "size",
    "REQUIRE_COMFY_KITCHEN_CUDA": "1",
    "COMFYUI_ARGS": "--lowvram --vram-headroom 2 --fast fp16_accumulation",
    "TINI_SUBREAPER": "1"
  }
}
